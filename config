if test -n "$ngx_module_link"; then
    ngx_module_type=STREAM
    ngx_module_name=$ngx_addon_name
    ngx_module_srcs="$_NGX_ADDON_SRCS"
    ngx_module_deps="$_NGX_ADDON_DEPS"
    ngx_module_libs="-lcrypto"

    . auto/module
else
    STREAM_MODULES="$STREAM_MODULES $ngx_addon_name"
    NGX_ADDON_SRCS="$NGX_ADDON_SRCS $_NGX_ADDON_SRCS"
    NGX_ADDON_DEPS="$NGX_ADDON_DEPS $_NGX_ADDON_DEPS"
fi
